{
  "name": "wazoo-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "npx @opennextjs/cloudflare build && npx wrangler dev",
    "deploy": "npx @opennextjs/cloudflare build && npx wrangler deploy",
    "format": "prettier \"src/**/*.{ts,tsx,css}\" --write",
    "format:check": "prettier \"src/**/*.{ts,tsx,css}\" --check"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@wazoo/client": "npm:@jsr/wazoo__client@^0.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "nuqs": "^2.9.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "wrangler": "^4.112.0"
  }
}
