{
  "name": "wazoo-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:emulate:vercel": "emulate --service vercel --seed emulate.config.yaml",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "npx @opennextjs/cloudflare build && npx wrangler dev",
    "build:qa": "next build",
    "build:prod": "next build",
    "deploy": "npx @opennextjs/cloudflare build && npx wrangler deploy",
    "deploy:qa": "npx @opennextjs/cloudflare build && npx wrangler deploy --env qa",
    "format": "prettier \"src/**/*.{ts,tsx,css}\" --write",
    "format:check": "prettier \"src/**/*.{ts,tsx,css}\" --check",
    "test:worlds": "tsx scripts/test-worlds.ts"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-select": "^2.3.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@wazoo/client": "npm:@jsr/wazoo__client@^0.1.4",
    "@workos-inc/authkit-nextjs": "^4.3.0",
    "@workos-inc/node": "^10.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "joyful": "^1.3.0",
    "lucide-react": "^0.562.0",
    "next": "^16.1.1",
    "nuqs": "^2.9.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "emulate": "^0.9.0",
    "prettier": "^3.9.5",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.112.0"
  }
}
