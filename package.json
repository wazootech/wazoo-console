{
  "name": "wazoo-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "deploy": "vite build && npx wrangler@latest deploy",
    "cf-typegen": "wrangler types",
    "format": "prettier \"src/**/*.{ts,svelte,js,css}\" --write",
    "format:check": "prettier \"src/**/*.{ts,svelte,js,css}\" --check"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "prettier": "^3.9.5",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "latest",
    "svelte-check": "latest",
    "typescript": "latest",
    "vite": "latest",
    "wrangler": "latest"
  }
}
