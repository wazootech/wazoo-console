// PR preview Worker for the console, built by Cloudflare Workers Builds (not
// GitHub Actions, so no PR workflow holds a deploy credential; contract-lint R5).
//
//   Build command:   pnpm run build:preview
//   Deploy (main):   npx wrangler deploy -c wrangler.preview.jsonc
//   Preview (PRs):   npx wrangler versions upload -c wrangler.preview.jsonc
//
// It is a separate Worker from wazoo-console / wazoo-console-qa, with a build
// token scoped to this Worker only. It talks to the API previews and uses the QA WorkOS
// staging secrets, set on this Worker. Previews are served at
// <preview-name>.preview.console.wazoo.dev (wildcard DNS + cert, as on
// blog.wazoo.dev); WorkOS allowlists https://*.preview.console.wazoo.dev/callback.
{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "wazoo-console-preview",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "preview.console.wazoo.dev",
      "custom_domain": true,
      "previews_enabled": true,
      "enabled": false
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "wazoo-console-preview"
    }
  ],
  "vars": {
    // Fallback API: the preview that tracks main. A same-alias API preview
    // (<alias>.preview.api.wazoo.dev) wins when it answers /health; see
    // src/lib/preview-api.ts.
    "NEXT_PUBLIC_API_URL": "https://main.preview.api.wazoo.dev",
    "WAZOO_PREVIEW": "true",
    // Per-branch hostnames: derive the WorkOS callback from the request.
    "WORKOS_REDIRECT_FROM_ORIGIN": "true"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
