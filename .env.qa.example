# QA environment reference for wazoo-console
# Copy this file to `.env.qa` and fill in real values.
# These values are used for local scripts and ad-hoc commands against QA.
# Runtime secrets on the QA Worker are set via `wrangler secret put --env qa`.

# WorkOS AuthKit configuration for QA.
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
WORKOS_COOKIE_PASSWORD="<at least 32 characters>"

# Public build-time vars.
NEXT_PUBLIC_WORKOS_REDIRECT_URI="https://console-qa.wazoo.dev/callback"
NEXT_PUBLIC_API_URL="https://api-qa.wazoo.dev"

# Global platform admin token used for server-to-server calls to wazoo-api.
# Must match the WAZOO_PLATFORM_ADMIN_TOKEN secret on the wazoo-api-qa Worker.
WAZOO_PLATFORM_ADMIN_TOKEN="wzp_..."
